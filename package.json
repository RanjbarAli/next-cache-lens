{
  "name": "next-cache-lens",
  "version": "0.1.0",
  "description": "Visual cache observability and debugging for Next.js.",
  "type": "module",
  "license": "MIT",
  "author": "Next Cache Lens contributors",
  "keywords": [
    "nextjs",
    "next",
    "cache",
    "devtools",
    "debugging",
    "observability",
    "cache-components",
    "react",
    "developer-tools",
    "cache-invalidation"
  ],
  "engines": {
    "node": ">=20.9.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "packageManager": "pnpm@10.34.5",
  "files": [
    "dist",
    "docs",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./config": {
      "import": {
        "types": "./dist/config.d.ts",
        "default": "./dist/config.js"
      },
      "require": {
        "types": "./dist/config.d.cts",
        "default": "./dist/config.cjs"
      },
      "default": "./dist/config.js"
    },
    "./devtools": {
      "types": "./dist/devtools.d.ts",
      "import": "./dist/devtools.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    },
    "./trace": {
      "types": "./dist/trace.d.ts",
      "import": "./dist/trace.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "import": "./dist/types.js"
    },
    "./package.json": "./package.json"
  },
  "peerDependencies": {
    "next": ">=16.0.0 <17",
    "react": ">=19.0.0 <20",
    "react-dom": ">=19.0.0 <20"
  },
  "scripts": {
    "build": "tsup --config tsup.config.ts && tsup --config tsup.compat.config.ts && tsup --config tsup.devtools.config.ts",
    "clean": "rimraf dist coverage test-results playwright-report examples/next-app/.next tests/fixtures/consumer/.next",
    "dev": "tsup --watch",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run tests/unit",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "playwright test",
    "test:consumer": "node scripts/test-consumer.mjs",
    "build:example": "pnpm build && pnpm --dir examples/next-app build",
    "size": "node scripts/measure-bundle.mjs",
    "validate:package": "publint && attw --pack . --profile esm-only && attw --pack . --profile node16 --entrypoints ./config",
    "validate": "pnpm build && pnpm validate:package && npm pack --dry-run",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm validate:package",
    "prepack": "pnpm build"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.2",
    "@eslint/js": "^9.39.2",
    "@playwright/test": "^1.58.2",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20.19.33",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitest/coverage-v8": "3.2.6",
    "eslint": "^9.39.2",
    "esbuild": "0.28.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.3.0",
    "jsdom": "26.1.0",
    "next": "16.3.2",
    "prettier": "^3.8.1",
    "publint": "^0.3.17",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "rimraf": "^6.1.3",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.1",
    "vite": "6.4.3",
    "vitest": "3.2.6"
  }
}
